{
  "name": "changji",
  "version": "1.1.3",
  "private": true,
  "description": "畅记：通过打字练习英语词汇",
  "author": "畅记项目贡献者",
  "license": "MIT",
  "main": "desktop/main.cjs",
  "scripts": {
    "start": "node server.cjs",
    "import:vocab": "node scripts/import-vocabulary.cjs",
    "desktop": "electron .",
    "build:win": "electron-builder --win portable --x64",
    "build:source": "node scripts/package-source.cjs",
    "check": "node --check dist/app.js && node --check dist/passage.js && node --check desktop/main.cjs && node qa-translations.cjs"
  },
  "devDependencies": {
    "electron": "44.10.2",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "cn.changji.practice",
    "productName": "畅记",
    "electronVersion": "44.10.2",
    "directories": {
      "output": "release/v1.1",
      "buildResources": "build"
    },
    "files": [
      "desktop/**",
      "dist/**",
      "!dist/downloads/**",
      "LICENSE",
      "THIRD-PARTY-NOTICES.md",
      "README.md",
      "build/icon.png"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "signExecutable": false
    },
    "portable": {
      "artifactName": "Changji-v1.1.3-Windows-x64.exe",
      "requestExecutionLevel": "user"
    },
    "npmRebuild": false
  }
}
